{
  "name": "opencode-websearch",
  "version": "0.7.1",
  "description": "Web search plugin for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": "./server.js"
  },
  "files": [
    "dist",
    "server.js"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun run --watch src/index.ts",
    "format": "oxfmt src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "lint": "oxlint --tsconfig tsconfig.json src/ test/",
    "lint:fix": "oxlint --tsconfig tsconfig.json --fix src/ test/",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "web-search",
    "anthropic",
    "openai",
    "xai",
    "grok",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/emilsvennesson/opencode-websearch.git"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@opencode/plugin": "^2.1.4",
    "openai": "^7.43.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "typescript": "^5.8.0"
  }
}
